# Название проекта
PROJECT_NAME=auth

# Ограничение частоты попыток входа

# Максимальное количество попыток входа для одного логина
LOGIN_RATE_LIMIT_ACCOUNT=15

# Максимальное количество попыток входа с одного IP-адреса
LOGIN_RATE_LIMIT_IP=30

# Период действия ограничения в секундах (15 минут)
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600

# SQLAlchemy
SQLALCHEMY_LOG_LEVEL=WARNING
SQLALCHEMY_HIDE_PARAMETERS=true

# Postgresql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=auth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123qwe

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Jaeger
JAEGER_HOST=jaeger
JAEGER_PORT=4317
JAEGER_INSECURE=false

# Create superuser
SUPERUSER_LOGIN=admin
SUPERUSER_PASSWORD=admin

YADNEX_SECRET_KEY=string
YANDEX_CLIENT_ID=string
YANDEX_CODE_URL=https://oauth.yandex.ru/authorize
YANDEX_TOKEN_URL=https://oauth.yandex.ru/token
YANDEX_USER_INFO_URL=https://login.yandex.ru/info?

YANDEX_DEBUG_TOKEN=string
TOKEN_DEBUG_MODE=True
