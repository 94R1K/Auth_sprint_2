# Название проекта
PROJECT_NAME=auth

# Секретный ключ HMAC
RATE_LIMIT_SECRET=secret

# Лимит запросов по IP за 5 минут
IP_RATE_LIMIT=100
IP_RATE_LIMIT_WINDOW=300

# Лимит запроса пользователя за 5 минут
USER_RATE_LIMIT=100
USER_RATE_LIMIT_WINDOW=300

# SQLAlchemy
SQLALCHEMY_LOG_LEVEL=WARNING
SQLALCHEMY_HIDE_PARAMETERS=true

# Postgresql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=auth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123qwe

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Jaeger
JAEGER_HOST=jaeger
JAEGER_PORT=4317
JAEGER_INSECURE=false

# Create superuser
SUPERUSER_LOGIN=admin
SUPERUSER_PASSWORD=admin

YADNEX_SECRET_KEY=string
YANDEX_CLIENT_ID=string
YANDEX_CODE_URL=https://oauth.yandex.ru/authorize
YANDEX_TOKEN_URL=https://oauth.yandex.ru/token
YANDEX_USER_INFO_URL=https://login.yandex.ru/info?

YANDEX_DEBUG_TOKEN=string
TOKEN_DEBUG_MODE=True
